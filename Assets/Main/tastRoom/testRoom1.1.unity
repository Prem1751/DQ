    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E42\u0E2D\u0E30 \u0E44\u0E2D\u0E23\u0E34\u0E19 \u0E2B\u0E27\u0E31\u0E14\u0E14\u0E35"
