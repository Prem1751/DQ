--- !u!114 &1748273083
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1748273082}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 222da0c3dcb6de94dac18c644a4b7be1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 931682958}
  nameText: {fileID: 230116705}
  dialogueText: {fileID: 215569453}
  speakerImage: {fileID: 1961910908}
  defaultNpcName: Hyung-gil
  dialogueLines:
  - text: "(\u0E23\u0E30\u0E2B\u0E27\u0E48\u0E32\u0E07\u0E17\u0E35\u0E48\u0E0B\u0E34\u0E19\u0E08\u0E30\u0E40\u0E14\u0E34\u0E19\u0E21\u0E32\u0E19\u0E31\u0E48\u0E07\u0E17\u0E35\u0E48\u0E01\u0E47\u0E21\u0E35\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E0B\u0E38\u0E1A\u0E0B\u0E34\u0E1A\u0E08\u0E32\u0E01\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E43\u0E19\u0E2B\u0E49\u0E2D\u0E07)"
    characterName: 
    characterSprite: {fileID: -6192198978236710653, guid: e3b857e62b4f4154a8bf9649082762ea, type: 3}
    voiceOver: {fileID: 0}
  - text: "**\u0E14\u0E39\u0E19\u0E31\u0E48\u0E19\u0E2A\u0E34 \u0E22\u0E31\u0E22\u0E0B\u0E34\u0E19\u0E21\u0E31\u0E19\u0E2A\u0E19\u0E34\u0E17\u0E01\u0E31\u0E1A\u0E25\u0E39\u0E01\u0E1C\u0E2D.\u0E14\u0E49\u0E27\u0E22!**"
    characterName: 
    characterSprite: {fileID: 2688917216832270636, guid: e3b857e62b4f4154a8bf9649082762ea, type: 3}
    voiceOver: {fileID: 0}
  - text: "**\u0E41\u0E15\u0E48\u0E0B\u0E34\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E2A\u0E19\u0E34\u0E17\u0E02\u0E2D\u0E07\u0E14\u0E32\u0E23\u0E34\u0E19\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E40\u0E2B\u0E23\u0E2D?**"
    characterName: 
    characterSprite: {fileID: -1728315880585781249, guid: e3b857e62b4f4154a8bf9649082762ea, type: 3}
    voiceOver: {fileID: 0}
  - text: "**\u0E19\u0E31\u0E48\u0E19\u0E2A\u0E34 \u0E46 \u0E43\u0E04\u0E23 \u0E46
      \u0E40\u0E02\u0E32\u0E01\u0E47\u0E23\u0E39\u0E49 \u0E27\u0E48\u0E32\u0E14\u0E32\u0E23\u0E34\u0E19\u0E01\u0E31\u0E1A\u0E44\u0E2D\u0E23\u0E34\u0E19\u0E44\u0E21\u0E48\u0E16\u0E39\u0E01\u0E01\u0E31\u0E19
      \u0E41\u0E15\u0E48\u0E22\u0E31\u0E22\u0E0B\u0E34\u0E19\u0E01\u0E47\u0E22\u0E31\u0E07\u0E44\u0E1B\u0E2A\u0E19\u0E34\u0E17\u0E14\u0E49\u0E27\u0E22**"
    characterName: 
    characterSprite: {fileID: -6192198978236710653, guid: e3b857e62b4f4154a8bf9649082762ea, type: 3}
    voiceOver: {fileID: 0}
  - text: "** \u0E43\u0E2B\u0E49\u0E15\u0E32\u0E22\u0E40\u0E16\u0E2D\u0E30 \u0E23\u0E33\u0E04\u0E32\u0E0D\u0E04\u0E19\u0E1E\u0E27\u0E01\u0E19\u0E35\u0E49\u0E08\u0E23\u0E34\u0E07
      \u0E46 **"
    characterName: "\u0E0B\u0E34\u0E19(\u0E04\u0E34\u0E14\u0E43\u0E19\u0E43\u0E08)"
    characterSprite: {fileID: -6192198978236710653, guid: e3b857e62b4f4154a8bf9649082762ea, type: 3}
    voiceOver: {fileID: 0}
  - text: "\u0E2B\u0E22\u0E38\u0E14\u0E1E\u0E39\u0E14\u0E01\u0E31\u0E19\u0E44\u0E14\u0E49\u0E2B\u0E23\u0E37\u0E2D\u0E22\u0E31\u0E07\u0E04\u0E30?"
    characterName: ???
    characterSprite: {fileID: -6192198978236710653, guid: e3b857e62b4f4154a8bf9649082762ea, type: 3}
    voiceOver: {fileID: 0}
  - text: "\u0E14\u0E30..\u0E14\u0E32?"
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 2636601409604470716, guid: 55c832c61160c7e49b2eac26a13b8182, type: 3}
    voiceOver: {fileID: 0}
  - text: "\u0E0B\u0E34\u0E19\u0E08\u0E30\u0E2A\u0E19\u0E34\u0E17\u0E01\u0E31\u0E1A\u0E43\u0E04\u0E23\u0E2B\u0E23\u0E37\u0E2D\u0E2D\u0E30\u0E44\u0E23\u0E41\u0E25\u0E49\u0E27\u0E21\u0E31\u0E19\u0E40\u0E01\u0E35\u0E48\u0E22\u0E27\u0E2D\u0E30\u0E44\u0E23\u0E01\u0E31\u0E1A\u0E1E\u0E27\u0E01\u0E40\u0E18\u0E2D"
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: -6192198978236710653, guid: e3b857e62b4f4154a8bf9649082762ea, type: 3}
    voiceOver: {fileID: 0}
  - text: "\u0E43\u0E08\u0E40\u0E22\u0E47\u0E19 \u0E46 \u0E19\u0E30\u0E14\u0E32\u0E23\u0E34\u0E19
      \u0E44\u0E21\u0E48\u0E21\u0E35\u0E43\u0E04\u0E23\u0E27\u0E48\u0E32\u0E2D\u0E30\u0E44\u0E23\u0E0B\u0E34\u0E19\u0E2B\u0E23\u0E2D\u0E01"
    characterName: "\u0E19\u0E31\u0E01\u0E40\u0E23\u0E35\u0E22\u0E191"
    characterSprite: {fileID: -6192198978236710653, guid: e3b857e62b4f4154a8bf9649082762ea, type: 3}
    voiceOver: {fileID: 0}
  - text: "\u0E08\u0E23\u0E34\u0E07\u0E40\u0E2B\u0E23\u0E2D\u0E0B\u0E34\u0E19?"
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E43\u0E0A\u0E48\u0E41\u0E25\u0E49\u0E27\u0E07\u0E31\u0E49\u0E19\u0E40\u0E23\u0E32\u0E44\u0E1B\u0E19\u0E31\u0E48\u0E07\u0E17\u0E35\u0E48\u0E01\u0E31\u0E19\u0E40\u0E16\u0E2D\u0E30\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 2636601409604470716, guid: 55c832c61160c7e49b2eac26a13b8182, type: 3}
    voiceOver: {fileID: 0}
  - text: "\u0E2D\u0E30..\u0E2D\u0E37\u0E21!"
