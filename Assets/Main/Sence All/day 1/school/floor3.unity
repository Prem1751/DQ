  nameText: {fileID: 1716818270}
  dialogueText: {fileID: 1712059433}
  speakerImage: {fileID: 1053632397}
  defaultNpcName: "\u0E40\u0E0A\u0E19"
  dialogueLines:
  - text: "\u0E14\u0E32\u0E23\u0E34\u0E4A\u0E19\u0E19\u0E19\u0E19\u0E19 \u0E40\u0E0A\u0E19\u0E04\u0E34\u0E14\u0E16\u0E36\u0E07\u0E08\u0E31\u0E07\u0E40\u0E25\u0E22"
    characterName: "\u0E40\u0E0A\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E0A\u0E39\u0E48\u0E27! \u0E40\u0E1A\u0E32\u0E46 \u0E2A\u0E34"
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E02\u0E2D\u0E42\u0E17\u0E29 \u0E1E\u0E2D\u0E14\u0E35\u0E40\u0E23\u0E32\u0E40\u0E04\u0E23\u0E35\u0E22\u0E14\u0E01\u0E31\u0E1A\u0E02\u0E49\u0E2D\u0E2A\u0E2D\u0E1A\u0E21\u0E32\u0E01\u0E19\u0E48\u0E30"
    characterName: "\u0E40\u0E0A\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E44\u0E2B\u0E27\u0E44\u0E2B\u0E21\u0E40\u0E0A\u0E19 \u0E44\u0E1B\u0E2B\u0E32\u0E2D\u0E30\u0E44\u0E23\u0E01\u0E34\u0E19\u0E17\u0E35\u0E48\u0E15\u0E25\u0E32\u0E14\u0E2B\u0E25\u0E31\u0E07\u0E42\u0E23\u0E07\u0E40\u0E23\u0E35\u0E22\u0E19\u0E44\u0E2B\u0E21?\r\n\u0E0B\u0E34\u0E19\u0E27\u0E48\u0E32\u0E44\u0E07"
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E44\u0E14\u0E49\u0E46 \u0E2D\u0E22\u0E48\u0E32\u0E07\u0E19\u0E49\u0E2D\u0E22\u0E01\u0E47\u0E44\u0E1B\u0E04\u0E25\u0E32\u0E22\u0E40\u0E04\u0E23\u0E35\u0E22\u0E14\u0E01\u0E31\u0E19"
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 158472470585449025, guid: d6de88a9f7957c440a5e40131d6186f8, type: 3}
    voiceOver: {fileID: 0}
  - text: "\u0E16\u0E49\u0E32\u0E14\u0E32\u0E01\u0E31\u0E1A\u0E0B\u0E34\u0E19\u0E27\u0E48\u0E32\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E19\u0E31\u0E49\u0E19...\u0E01\u0E47\u0E44\u0E14\u0E49\u0E04\u0E23\u0E31\u0E1A"
    characterName: "\u0E40\u0E0A\u0E19"
