    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E44\u0E14\u0E49\u0E2D\u0E48\u0E32\u0E19\u0E21\u0E32\u0E1A\u0E49\u0E32\u0E07\u0E44\u0E2B\u0E21?"
