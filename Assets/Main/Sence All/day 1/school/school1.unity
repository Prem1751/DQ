    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: " \u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E2D\u0E48\u0E32\u0E19 "
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E01\u0E47\u0E2A\u0E21\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E18\u0E2D\u0E14\u0E35 "
