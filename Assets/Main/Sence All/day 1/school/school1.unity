    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E2A\u0E21\u0E31\u0E22\u0E40\u0E14\u0E47\u0E01\u0E2A\u0E38\u0E14\u0E17\u0E35\u0E48\u0E23\u0E31\u0E01\u0E44\u0E1B\u0E44\u0E2B\u0E19\u0E41\u0E25\u0E49\u0E27"
