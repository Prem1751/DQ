  defaultNpcName: "\u0E42\u0E17\u0E23\u0E28\u0E31\u0E1E\u0E17\u0E4C"
  dialogueLines:
  - text: "\u0E2D\u0E37\u0E21 \u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E01\u0E47\u0E44\u0E14\u0E49\u0E40\u0E08\u0E2D\u0E2D\u0E30\u0E44\u0E23\u0E21\u0E32\u0E2B\u0E25\u0E32\u0E22\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E40\u0E25\u0E22"
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
    choiceScores: 
    choiceLeadsTo: 
    postChoiceDialogue: 
    changeSceneAfterThisLine: 0
    sceneNameToLoad: 
    sceneTransitionDelay: 0
    useScoreBasedTransition: 0
    requiredScore: 0
    scoreBasedSceneName: 
  - text: "\u0E40\u0E25\u0E48\u0E19\u0E42\u0E17\u0E23\u0E28\u0E31\u0E1E\u0E17\u0E4C\u0E2B\u0E19\u0E48\u0E2D\u0E22\u0E14\u0E35\u0E01\u0E27\u0E48\u0E32"
