    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
    choiceScores: 
    choiceLeadsTo: 
    postChoiceDialogue: 
    changeSceneAfterThisLine: 0
    sceneNameToLoad: 
    sceneTransitionDelay: 0
    useScoreBasedTransition: 0
    requiredScore: 0
    scoreBasedSceneName: 
  - text: "\u0E0B\u0E34\u0E19\u0E01\u0E47\u0E44\u0E14\u0E49\u0E40\u0E25\u0E37\u0E48\u0E2D\u0E19\u0E44\u0E1B\u0E40\u0E08\u0E2D\u0E02\u0E48\u0E32\u0E27
      Fake News \u0E15\u0E48\u0E32\u0E07 \u0E46 \u0E1A\u0E19\u0E42\u0E25\u0E01\u0E2D\u0E2D\u0E19\u0E44\u0E25\u0E19\u0E4C"
    characterName: 
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
    choiceScores: 
    choiceLeadsTo: 
    postChoiceDialogue: 
    changeSceneAfterThisLine: 0
    sceneNameToLoad: 
    sceneTransitionDelay: 0
    useScoreBasedTransition: 0
    requiredScore: 0
    scoreBasedSceneName: 
  - text: "\u0E19\u0E31\u0E01\u0E40\u0E23\u0E35\u0E22\u0E19\u0E2A\u0E32\u0E27\u0E40\u0E02\u0E49\u0E32\u0E41\u0E08\u0E49\u0E07\u0E04\u0E27\u0E32\u0E21\u0E2B\u0E25\u0E31\u0E07\u0E08\u0E32\u0E01\u0E42\u0E14\u0E19\u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E40\u0E1F\u0E04\u0E19\u0E34\u0E27\u0E2A\u0E4C\u0E27\u0E48\u0E32\u0E40\u0E18\u0E2D\u0E1E\u0E01\u0E22\u0E32\u0E40\u0E2A\u0E1E\u0E15\u0E34\u0E14\u0E21\u0E32\u0E42\u0E23\u0E07\u0E40\u0E23\u0E35\u0E22\u0E19\r\n\u0E0A\u0E32\u0E27\u0E1A\u0E32\u0E49\u0E19\u0E41\u0E2B\u0E48\u0E01\u0E31\u0E19\u0E14\u0E37\u0E48\u0E21\u0E19\u0E32
      \u0E49\u0E08\u0E32\u0E01\u0E1A\u0E48\u0E2D\u0E02\u0E32\u0E49\u0E07\u0E28\u0E32\u0E25
      \u0E40\u0E19\u0E48\u0E37\u0E2D\u0E07\u0E08\u0E32\u0E01\u0E04\u0E34\u0E14\u0E27\u0E48\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E19\u0E49\u0E33\u0E28\u0E31\u0E01\u0E14\u0E37\u0E4C\u0E2A\u0E34\u0E17\u0E18\u0E37\u0E4C"
    characterName: 
