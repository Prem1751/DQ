MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1668342483}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 645480aea09c25a47bf29746c80475d7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 538208722}
  nameText: {fileID: 1746198645}
  dialogueText: {fileID: 847273004}
  speakerImage: {fileID: 1538094021}
  defaultNpcName: "\u0E44\u0E2D\u0E23\u0E34\u0E19"
  dialogueLines:
  - text: "\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E27\u0E48\u0E32\u0E17\u0E35\u0E48\u0E1C\u0E48\u0E32\u0E19\u0E21\u0E32\u0E40\u0E23\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E01\u0E31\u0E19\u0E2B\u0E23\u0E2D\u0E01\u0E40\u0E2B\u0E23\u0E2D?
      \r\n"
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "...\u0E2E\u0E30..\u0E2E\u0E30\u0E2E\u0E48\u0E32 \u0E46 \u0E46 \u0E46 (\u0E44\u0E2D\u0E23\u0E34\u0E19\u0E2B\u0E31\u0E27\u0E40\u0E23\u0E32\u0E30\u0E2D\u0E2D\u0E01\u0E21\u0E32)\r\n\r\n"
    characterName: "\u0E44\u0E2D\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E19\u0E31\u0E48\u0E19\u0E2A\u0E34\u0E19\u0E30 \u0E17\u0E35\u0E48\u0E1C\u0E48\u0E32\u0E19\u0E21\u0E32\u0E40\u0E23\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E44\u0E14\u0E49\u0E41\u0E04\u0E48\u0E19\u0E31\u0E49\u0E19\u0E2A\u0E34\u0E19\u0E30\u0E40\u0E02\u0E49\u0E32\u0E43\u0E08\u0E41\u0E25\u0E49\u0E27\r\n"
    characterName: "\u0E44\u0E2D\u0E23\u0E34\u0E19 "
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E44\u0E2D\u0E23\u0E34\u0E19?"
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E02\u0E2D\u0E42\u0E17\u0E29\u0E17\u0E35\u0E1E\u0E2D\u0E14\u0E35\u0E40\u0E23\u0E32\u0E21\u0E35\u0E18\u0E38\u0E23\u0E30\u0E19\u0E48\u0E30\u0E44\u0E27\u0E40\u0E49\u0E08\u0E2D\u0E01\u0E31\u0E19\u0E1E\u0E23\u0E38\u0E48\u0E07\u0E19\u0E35\u0E49\u0E19\u0E30\r"
    characterName: "\u0E44\u0E2D\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E14\u0E30..\u0E40\u0E14\u0E35\u0E48\u0E22\u0E27!\r\n"
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E44\u0E2D\u0E23\u0E34\u0E19\u0E40\u0E14\u0E34\u0E19\u0E2D\u0E2D\u0E01\u0E44\u0E1B\u0E41\u0E25\u0E49\u0E27\u0E17\u0E34\u0E49\u0E07\u0E0B\u0E34\u0E19\u0E44\u0E27\u0E49\u0E43\u0E2B\u0E49\u0E19\u0E31\u0E48\u0E07\u0E04\u0E19\u0E40\u0E14\u0E35\u0E22\u0E27\r\n\r\n"
    characterName: 
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
