MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1940550659}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 645480aea09c25a47bf29746c80475d7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 723115172}
  nameText: {fileID: 833840803}
  dialogueText: {fileID: 1664831639}
  speakerImage: {fileID: 1770053470}
  defaultNpcName: "\u0E44\u0E2D\u0E23\u0E34\u0E19"
  dialogueLines:
  - text: "\u0E40\u0E23\u0E32\u0E40\u0E2D\u0E07...\u0E01\u0E47\u0E2D\u0E22\u0E32\u0E01\u0E2A\u0E19\u0E34\u0E17\u0E01\u0E31\u0E1A\u0E44\u0E2D\u0E23\u0E34\u0E19\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E01\u0E31\u0E19\u0E19\u0E30
      \r\n"
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: '...!


'
    characterName: "\u0E44\u0E2D\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E40\u0E23\u0E32\u0E19\u0E36\u0E01\u0E27\u0E48\u0E32\u0E40\u0E23\u0E32\u0E2D\u0E22\u0E32\u0E01\u0E2A\u0E19\u0E34\u0E17\u0E40\u0E2D\u0E07\u0E44\u0E1B\u0E04\u0E19\u0E40\u0E14\u0E35\u0E22\u0E27\u0E2D\u0E35\u0E01...\u0E44\u0E21\u0E48\u0E04\u0E34\u0E14\u0E27\u0E48\u0E32\u0E44\u0E2D\u0E23\u0E34\u0E19\u0E01\u0E47...\u0E2D\u0E22\u0E32\u0E01\u0E2A\u0E19\u0E34\u0E17\u0E01\u0E31\u0E1A\u0E40\u0E23\u0E32\u0E21\u0E32\u0E01\u0E01\u0E27\u0E48\u0E32\u0E14\u0E32\u0E23\u0E34\u0E19\u0E43\u0E0A\u0E48\u0E44\u0E2B\u0E21?\r\n\r"
    characterName: "\u0E44\u0E2D\u0E23\u0E34\u0E19 "
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E40\u0E23\u0E32\u0E19\u0E48\u0E30...\"\u0E16\u0E49\u0E32\u0E44\u0E21\u0E48\u0E21\u0E35\u0E14\u0E32\u0E23\u0E34\u0E19\u0E01\u0E47\u0E04\u0E07\u0E08\u0E30\u0E2A\u0E19\u0E34\u0E17\u0E01\u0E31\u0E19\u0E01\u0E27\u0E48\u0E32\u0E19\u0E35\u0E49*\u0E01\u0E23\u0E30\u0E0B\u0E34\u0E1A\u0E40\u0E1A\u0E32\u0E46*\"\u0E49
      (\u0E44\u0E2D\u0E23\u0E34\u0E19\u0E22\u0E34\u0E47\u0E21)"
    characterName: "\u0E44\u0E2D\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E2D\u0E30..\u0E40\u0E2D\u0E48\u0E2D\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E01\u0E35\u0E49\u0E44\u0E2D\u0E23\u0E34\u0E19\u0E1E\u0E39\u0E14\u0E2D\u0E30\u0E44\u0E23\u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E1B\u0E25\u0E48\u0E32?\r"
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E2B\u0E37\u0E2D?"
    characterName: "\u0E44\u0E2D\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "*\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E42\u0E17\u0E23\u0E28\u0E31\u0E1E\u0E17\u0E4C\u0E02\u0E2D\u0E07\u0E44\u0E2D\u0E23\u0E34\u0E19\u0E14\u0E31\u0E07\u0E02\u0E36\u0E49\u0E19*"
    characterName: "\u0E01\u0E23\u0E34\u0E4A\u0E07 \u0E01\u0E23\u0E34\u0E4A\u0E07
      \u0E01\u0E23\u0E34\u0E4A\u0E07...."
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E42\u0E2D\u0E4A\u0E30!!... \u0E40\u0E23\u0E32\u0E04\u0E07\u0E15\u0E49\u0E2D\u0E07\u0E44\u0E1B\u0E41\u0E25\u0E49\u0E27\u0E40\u0E23\u0E32\u0E40\u0E25\u0E35\u0E49\u0E22\u0E07\u0E0B\u0E34\u0E19\u0E40\u0E2D\u0E07\u0E19\u0E30
      \u0E44\u0E27\u0E49\u0E40\u0E08\u0E2D\u0E01\u0E31\u0E19\u0E1E\u0E23\u0E38\u0E48\u0E07\u0E19\u0E35\u0E49 "
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E44\u0E2D\u0E23\u0E34\u0E19\u0E40\u0E14\u0E34\u0E19\u0E2D\u0E2D\u0E01\u0E44\u0E1B\u0E41\u0E25\u0E49\u0E27\u0E17\u0E34\u0E49\u0E07\u0E0B\u0E34\u0E19\u0E44\u0E27\u0E49\u0E43\u0E2B\u0E49\u0E19\u0E31\u0E48\u0E07\u0E04\u0E19\u0E40\u0E14\u0E35\u0E22\u0E27\r\n\r\n"
