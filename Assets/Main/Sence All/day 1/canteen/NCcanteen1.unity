--- !u!114 &734033180
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 734033179}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 222da0c3dcb6de94dac18c644a4b7be1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 238072524}
  nameText: {fileID: 901517077}
  dialogueText: {fileID: 308120365}
  speakerImage: {fileID: 2127636807}
  defaultNpcName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
  dialogueLines:
  - text: "\u0E04\u0E19\u0E19\u0E35\u0E49\u0E04\u0E37\u0E2D?"
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E04\u0E19\u0E19\u0E35\u0E49\u0E0A\u0E37\u0E48\u0E2D\u0E40\u0E0A\u0E19\u0E19\u0E48\u0E30
      \u0E2A\u0E48\u0E27\u0E19\u0E19\u0E35\u0E48\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E2A\u0E21\u0E31\u0E22\u0E40\u0E14\u0E47\u0E01\u0E40\u0E23\u0E32\u0E0A\u0E37\u0E48\u0E2D\u0E0B\u0E34\u0E19 "
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E19\u0E30\u0E0B\u0E34\u0E19 \u0E40\u0E23\u0E32\u0E44\u0E14\u0E49\u0E22\u0E34\u0E19\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E40\u0E18\u0E2D\u0E08\u0E32\u0E01\u0E14\u0E32\u0E23\u0E34\u0E19\u0E1A\u0E48\u0E2D\u0E22
      \u0E46"
    characterName: "\u0E40\u0E0A\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E2D\u0E4B\u0E2D \u0E40\u0E0A\u0E19\u0E17\u0E35\u0E48\u0E2D\u0E22\u0E39\u0E48\u0E2B\u0E49\u0E2D\u0E07\u0E1A\u0E35\u0E19\u0E35\u0E48\u0E40\u0E2D\u0E07"
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "*\u0E04\u0E19\u0E19\u0E35\u0E49\u0E44\u0E07\u0E17\u0E35\u0E48\u0E40\u0E23\u0E32\u0E40\u0E25\u0E48\u0E32\u0E43\u0E2B\u0E49\u0E1F\u0E31\u0E07\u0E1A\u0E48\u0E2D\u0E22\u0E46
      \u0E17\u0E35\u0E48\u0E40\u0E1B\u0E47\u0E19\u0E41\u0E1F\u0E19\u0E40\u0E23\u0E32*"
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19\u0E40\u0E02\u0E49\u0E32\u0E21\u0E32\u0E01\u0E23\u0E30\u0E0B\u0E34\u0E1A\u0E01\u0E31\u0E1A\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E2B\u0E49\u0E30"
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E0A\u0E39\u0E48\u0E27! \u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E19\u0E35\u0E49\u0E40\u0E01\u0E47\u0E1A\u0E44\u0E27\u0E40\u0E49\u0E1B\u0E47\u0E19\u0E04\u0E27\u0E32\u0E21\u0E25\u0E31\u0E1A\u0E19\u0E30"
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E40\u0E18\u0E2D\u0E1A\u0E2D\u0E01\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E19\u0E31\u0E49\u0E19\u0E40\u0E2B\u0E23\u0E2D\u0E14\u0E32\u0E23\u0E34\u0E19
      ?"
    characterName: "\u0E40\u0E0A\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E43\u0E0A\u0E48 \u0E40\u0E01\u0E47\u0E1A\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E19\u0E35\u0E49\u0E44\u0E27\u0E49\u0E14\u0E49\u0E27\u0E22\u0E19\u0E30\u0E0B\u0E34\u0E19
      \u0E40\u0E23\u0E32\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E2D\u0E22\u0E32\u0E01\u0E43\u0E2B\u0E49\u0E04\u0E19\u0E2D\u0E37\u0E48\u0E19\u0E23\u0E39\u0E49"
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E2D\u0E30..\u0E42\u0E2D\u0E40\u0E04"
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "(\u0E19\u0E35\u0E48\u0E21\u0E31\u0E19\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E2D\u0E30\u0E44\u0E23\u0E40\u0E19\u0E35\u0E48\u0E22!?)"
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E01\u0E23\u0E30\u0E14\u0E34\u0E48\u0E07\u0E40\u0E23\u0E35\u0E22\u0E01\u0E43\u0E2B\u0E49\u0E40\u0E02\u0E49\u0E32\u0E2B\u0E49\u0E2D\u0E07\u0E2A\u0E2D\u0E1A"
    characterName: "\u0E01\u0E23\u0E34\u0E4A\u0E07 -\u0E01\u0E23\u0E48\u0E2D\u0E07
      - \u0E01\u0E23\u0E4A\u0E34\u0E07 - \u0E01\u0E23\u0E48\u0E2D\u0E07 "
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E44\u0E27\u0E49\u0E40\u0E08\u0E2D\u0E01\u0E31\u0E19\u0E19\u0E30\u0E40\u0E0A\u0E19"
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E04\u0E23\u0E31\u0E1A \u0E46 \u0E44\u0E27\u0E49\u0E40\u0E08\u0E2D\u0E01\u0E31\u0E19\u0E19\u0E30\u0E04\u0E23\u0E31\u0E1A"
    characterName: "\u0E40\u0E0A\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: ...
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  interactionRadius: 2
