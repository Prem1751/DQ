    choices: []
  - text: "\u0E40\u0E0A\u0E19 \u0E40\u0E23\u0E32\u0E2D\u0E22\u0E32\u0E01\u0E01\u0E34\u0E19\u0E2D\u0E31\u0E19\u0E19\u0E35\u0E49\u0E08\u0E31\u0E07"
