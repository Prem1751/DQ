    hasChoices: 0
    choices: []
  - text: "\u0E44\u0E21\u0E48\u0E46 \u0E40\u0E0A\u0E19\u0E2D\u0E22\u0E32\u0E01\u0E01\u0E34\u0E19\u0E44\u0E2B\u0E21
