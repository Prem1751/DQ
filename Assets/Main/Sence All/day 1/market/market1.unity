    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E40\u0E23\u0E32\u0E01\u0E25\u0E31\u0E1A\u0E21\u0E32\u0E41\u0E25\u0E49\u0E27!"
