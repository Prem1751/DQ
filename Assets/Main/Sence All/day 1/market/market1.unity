    hasChoices: 0
    choices: []
  - text: "\u0E04\u0E19\u0E17\u0E35\u0E48\u0E40\u0E0A\u0E37\u0E48\u0E2D\u0E04\u0E07\u0E08\u0E30\u0E01\u0E34\u0E19\u0E2B\u0E0D\u0E49\u0E32\u0E01\u0E31\u0E19\u0E2B\u0E21\u0E14"
