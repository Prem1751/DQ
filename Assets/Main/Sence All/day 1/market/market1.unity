    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E44\u0E14\u0E49\u0E04\u0E23\u0E31\u0E1A \u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E1C\u0E21\u0E0B\u0E37\u0E49\u0E2D\u0E43\u0E2B\u0E49"
