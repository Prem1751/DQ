    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E14\u0E35\u0E08\u0E31\u0E07\u0E40\u0E25\u0E22\u0E19\u0E30 \u0E2A\u0E19\u0E34\u0E17\u0E01\u0E31\u0E19\u0E19\u0E48\u0E32\u0E14\u0E39\u0E40\u0E25\u0E22\u0E2A\u0E34"
