    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E41\u0E25\u0E49\u0E27\u0E44\u0E1B\u0E40\u0E1B\u0E47\u0E19\u0E41\u0E1F\u0E19\u0E01\u0E31\u0E19\u0E44\u0E14\u0E49\u0E44\u0E07\u0E25\u0E48\u0E30
