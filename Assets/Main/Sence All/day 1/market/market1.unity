MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1741384818}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 222da0c3dcb6de94dac18c644a4b7be1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 1055724113}
  nameText: {fileID: 2074173839}
  dialogueText: {fileID: 687888831}
  speakerImage: {fileID: 1701297997}
  defaultNpcName: "\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
  dialogueLines:
  - text: "\u0E0B\u0E34\u0E19\u0E40\u0E14\u0E2D\u0E40\u0E23\u0E25\u0E25\u0E48\u0E32\u0E40\u0E2B\u0E23\u0E2D?"
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E40\u0E18\u0E2D\u0E2D\u0E35\u0E01\u0E41\u0E25\u0E49\u0E27\u0E40\u0E2B\u0E23\u0E2D\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E01\u0E47\u0E1E\u0E2D\u0E14\u0E35\u0E08\u0E30\u0E21\u0E32\u0E2B\u0E32\u0E2D\u0E30\u0E44\u0E23\u0E01\u0E34\u0E19\u0E19\u0E48\u0E30
      \u0E41\u0E25\u0E49\u0E27\u0E01\u0E47\u0E40\u0E08\u0E2D\u0E2A\u0E34\u0E48\u0E07\u0E17\u0E35\u0E48\u0E19\u0E48\u0E32\u0E2A\u0E19\u0E43\u0E08"
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E01\u0E47\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E40\u0E0A\u0E48\u0E19 \u0E19\u0E31\u0E01\u0E40\u0E23\u0E35\u0E22\u0E19\u0E14\u0E35\u0E40\u0E14\u0E48\u0E19\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E21\u0E32\u0E40\u0E14\u0E34\u0E19\u0E15\u0E25\u0E32\u0E14\u0E2B\u0E25\u0E31\u0E07\u0E42\u0E23\u0E07\u0E40\u0E23\u0E35\u0E22\u0E19\u0E01\u0E31\u0E1A\u0E04\u0E19\u0E40\u0E08\u0E49\u0E32\u0E0A\u0E39\u0E49\u0E1B\u0E23\u0E30\u0E08
      \u0E32\u0E15\u0E36\u0E01\u0E2A\u0E35\u0E48"
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: ....
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E2D\u0E4B\u0E2D\u0E43\u0E0A\u0E48 \u0E21\u0E35\u0E2D\u0E35\u0E01\u0E04\u0E19\u0E19\u0E36\u0E07\u0E14\u0E49\u0E27\u0E22\u0E19\u0E35\u0E48\u0E19\u0E32"
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E44\u0E21\u0E48\u0E23\u0E39\u0E49\u0E2D\u0E30\u0E44\u0E23\u0E01\u0E47\u0E2D\u0E22\u0E48\u0E32\u0E1E\u0E39\u0E14\u0E21\u0E31\u0E48\u0E27
      \u0E46 \u0E19\u0E30"
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E01\u0E47\u0E19\u0E30 \u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E01\u0E31\u0E1A\u0E17\u0E35\u0E48\u0E40\u0E02\u0E32\u0E40\u0E23\u0E35\u0E22\u0E01\u0E27\u0E48\u0E32\u0E2D\u0E30\u0E44\u0E23\u0E19\u0E30
      \u0E2D\u0E35\u0E01\u0E32\u0E01\u0E31\u0E1A\u0E2B\u0E07\u0E2A\u0E4C\u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E1B\u0E25\u0E48\u0E32?"
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: ...
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E0A\u0E31\u0E01\u0E08\u0E30\u0E23 \u0E32\u0E04\u0E32\u0E0D\u0E40\u0E18\u0E2D\u0E41\u0E25\u0E49\u0E27\u0E19\u0E30\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E0A\u0E31\u0E01\u0E08\u0E30\u0E23 \u0E32\u0E04\u0E32\u0E0D\u0E40\u0E18\u0E40\u0E18\u0E2D\u0E21\u0E35\u0E1B\u0E31\u0E0D\u0E2B\u0E32\u0E2D\u0E30\u0E44\u0E23\u0E01\u0E31\u0E1A\u0E09\u0E31\u0E19\u0E19\u0E31\u0E01\u0E2B\u0E19\u0E32\u0E41\u0E25\u0E49\u0E27\u0E19\u0E30\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E09\u0E31\u0E19\u0E44\u0E21\u0E48\u0E0A\u0E2D\u0E1A\u0E17\u0E35\u0E48\u0E40\u0E18\u0E2D\u0E44\u0E1B\u0E2D\u0E22\u0E39\u0E48\u0E43\u0E01\u0E25\u0E49\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E22\u0E31\u0E22\u0E19\u0E31\u0E48\u0E19\u0E15\u0E49\u0E2D\u0E07\u0E15\u0E31\u0E49\u0E07\u0E43\u0E08\u0E43\u0E2B\u0E49\u0E40\u0E18\u0E2D\u0E42\u0E14\u0E19\u0E40\u0E1B\u0E23\u0E35\u0E22\u0E1A\u0E40\u0E17\u0E35\u0E22\u0E1A\u0E41\u0E1A\u0E1A\u0E19\u0E35\u0E49\u0E41\u0E19\u0E48\u0E46"
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E41\u0E25\u0E49\u0E27\u0E21\u0E31\u0E19\u0E40\u0E01\u0E35\u0E48\u0E22\u0E27\u0E2D\u0E30\u0E44\u0E23\u0E01\u0E31\u0E1A\u0E40\u0E18\u0E2D"
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E19\u0E31\u0E48\u0E19\u0E2A\u0E34\u0E19\u0E30 \u0E04\u0E27\u0E32\u0E21\u0E40\u0E1B\u0E47\u0E19\u0E2B\u0E48\u0E27\u0E07\u0E02\u0E2D\u0E07\u0E09\u0E31\u0E19\u0E04\u0E07\u0E2A\u0E48\u0E07\u0E44\u0E21\u0E48\u0E16\u0E36\u0E07\u0E40\u0E18\u0E2D\u0E2B\u0E23\u0E2D\u0E01"
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
