    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E02\u0E2D\u0E43\u0E2B\u0E49\u0E21\u0E32\u0E40\u0E0A\u0E37\u0E48\u0E2D\u0E2B\u0E23\u0E2D\u0E01
