    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
  - text: "\u0E01\u0E47\u0E19\u0E31\u0E48\u0E19\u0E19\u0E48\u0E30\u0E2A\u0E34 \u0E16\u0E36\u0E07\u0E08\u0E30\u0E21\u0E35\u0E41\u0E15\u0E48\u0E04\u0E19\u0E1A\u0E2D\u0E01\u0E27\u0E48\u0E32\u0E40\u0E23\u0E32\u0E01\u0E31\u0E1A\u0E44\u0E2D\u0E23\u0E34\u0E19\u0E44\u0E21\u0E48\u0E16\u0E39\u0E01\u0E01\u0E31\u0E19"
