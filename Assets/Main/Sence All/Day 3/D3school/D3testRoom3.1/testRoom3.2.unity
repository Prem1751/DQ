    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E2D\u0E35\u0E01\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E1C\u0E25\u0E01\u0E47\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E2D\u0E2D\u0E01\u0E21\u0E32\u0E0A\u0E31\u0E14\u0E40\u0E08\u0E19\u0E2A\u0E31\u0E01\u0E2B\u0E2B\u0E19\u0E48\u0E2D\u0E22"
    characterName: "\u0E0B\u0E34\u0E19"
    characterSprite: {fileID: 0}
