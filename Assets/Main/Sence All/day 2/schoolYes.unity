  defaultNpcName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
  dialogueLines:
  - text: "\u0E40\u0E01\u0E34\u0E14\u0E2D\u0E30\u0E44\u0E23\u0E02\u0E36\u0E49\u0E19\u0E14\u0E32
      \u0E40\u0E18\u0E2D\u0E40\u0E1B\u0E47\u0E19\u0E2D\u0E30\u0E44\u0E23\u0E21\u0E31\u0E49\u0E22\r\n"
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 158472470585449025, guid: d6de88a9f7957c440a5e40131d6186f8, type: 3}
    voiceOver: {fileID: 0}
  - text: ...
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E14\u0E32\u0E23\u0E34\u0E19? \u0E1F\u0E31\u0E07\u0E09\u0E31\u0E19\u0E2D\u0E22\u0E39\u0E48\u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E1B\u0E25\u0E48\u0E32"
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 158472470585449025, guid: d6de88a9f7957c440a5e40131d6186f8, type: 3}
    voiceOver: {fileID: 0}
  - text: "\u0E44\u0E21\u0E48\u0E40\u0E1B\u0E47\u0E19\u0E44\u0E23\u0E19\u0E30\u0E14\u0E32
      \u0E0B\u0E34\u0E19\u0E22\u0E31\u0E07\u0E2D\u0E22\u0E39\u0E48\u0E04\u0E15\u0E23\u0E07\u0E19\u0E35\u0E49\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E14\u0E32\u0E19\u0E30"
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 158472470585449025, guid: d6de88a9f7957c440a5e40131d6186f8, type: 3}
    voiceOver: {fileID: 0}
  - text: "\u0E0B\u0E30...\u0E0B\u0E34\u0E19?"
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: ...
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E02\u0E2D\u0E1A\u0E04\u0E38\u0E13\u0E19\u0E30"
    characterName: "\u0E14\u0E32\u0E23\u0E34\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E40\u0E23\u0E32\u0E44\u0E1B\u0E40\u0E15\u0E23\u0E35\u0E22\u0E21\u0E15\u0E31\u0E27\u0E40\u0E02\u0E49\u0E32\u0E2B\u0E49\u0E2D\u0E07\u0E2A\u0E2D\u0E1A\u0E01\u0E31\u0E19\u0E40\u0E16\u0E2D\u0E30\u0E14\u0E32"
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 158472470585449025, guid: d6de88a9f7957c440a5e40131d6186f8, type: 3}
    voiceOver: {fileID: 0}
  - text: "\u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E01\u0E47\u0E27\u0E31\u0E19\u0E2A\u0E2D\u0E1A\u0E27\u0E31\u0E19\u0E2A\u0E38\u0E14\u0E17\u0E32\u0E49\u0E22\u0E41\u0E25\u0E49\u0E27\u0E21\u0E32\u0E1E\u0E22\u0E32\u0E22\u0E32\u0E21\u0E14\u0E49\u0E27\u0E22\u0E01\u0E31\u0E19\u0E19\u0E30\r\r\n"
    characterName: "\u0E0B\u0E35\u0E19"
