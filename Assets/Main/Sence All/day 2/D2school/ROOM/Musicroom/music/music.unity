    sceneTransitionDelay: 0
    useScoreBasedTransition: 0
    requiredScore: 0
    scoreBasedSceneName: 
  - text: "\u0E0B\u0E34\u0E19\u0E22\u0E37\u0E19\u0E21\u0E2D\u0E07\u0E08\u0E19\u0E44\u0E2D\u0E23\u0E34\u0E19\u0E40\u0E25\u0E48\u0E19\u0E08\u0E19\u0E08\u0E1A\u0E04\u0E31\u0E17\u0E0B\u0E35\u0E19"
