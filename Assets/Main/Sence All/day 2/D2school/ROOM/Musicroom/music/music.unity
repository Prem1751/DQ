    sceneTransitionDelay: 0
    useScoreBasedTransition: 0
    requiredScore: 0
    scoreBasedSceneName: 
  - text: "\u0E2D\u0E37\u0E2D \u0E40\u0E18\u0E2D\u0E22\u0E31\u0E07\u0E40\u0E25\u0E48\u0E19\u0E40\u0E1E\u0E23\u0E32\u0E30\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E40\u0E14\u0E34\u0E21\u0E40\u0E25\u0E22"
