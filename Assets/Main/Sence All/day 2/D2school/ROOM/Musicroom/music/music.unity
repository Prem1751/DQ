    sceneTransitionDelay: 0
    useScoreBasedTransition: 0
    requiredScore: 0
    scoreBasedSceneName: 
  - text: "\u0E40\u0E18\u0E2D\u0E0A\u0E2D\u0E1A\u0E44\u0E2B\u0E21?"
    characterName: "\u0E44\u0E2D\u0E23\u0E34\u0E19"
