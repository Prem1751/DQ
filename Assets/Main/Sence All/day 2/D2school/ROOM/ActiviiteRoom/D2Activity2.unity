    scoreBasedSceneName: 
  - text: "\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48 ! \u0E40\u0E25\u0E34\u0E01\u0E22\u0E38\u0E48\u0E07\u0E01\u0E31\u0E1A\u0E41\u0E1F\u0E19\u0E1C\u0E21\u0E44\u0E14\u0E49\u0E41\u0E25\u0E49\u0E27"
    characterName: "\u0E40\u0E0A\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
    choiceScores: 
