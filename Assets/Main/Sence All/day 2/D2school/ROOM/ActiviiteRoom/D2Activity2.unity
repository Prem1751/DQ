  defaultNpcName: NPC
  dialogueLines:
  - text: "\u0E17\u0E33\u0E41\u0E1A\u0E1A\u0E19\u0E35\u0E49\u0E17\u0E33\u0E44\u0E21"
    characterName: "\u0E40\u0E0A\u0E19"
