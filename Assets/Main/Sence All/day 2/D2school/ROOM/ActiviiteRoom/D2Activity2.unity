    choiceLeadsTo: 
    postChoiceDialogue: 
    changeSceneAfterThisLine: 0
    sceneNameToLoad: 
    sceneTransitionDelay: 0
    useScoreBasedTransition: 0
    requiredScore: 0
    scoreBasedSceneName: 
  - text: "\u0E2B\u0E36 \u0E40\u0E02\u0E49\u0E32\u0E43\u0E08\u0E41\u0E25\u0E49\u0E27
