    sceneTransitionDelay: 0
    useScoreBasedTransition: 0
    requiredScore: 0
    scoreBasedSceneName: 
  - text: "\u0E17\u0E33\u0E2D\u0E30\u0E44\u0E23\u0E40\u0E2B\u0E23\u0E2D \u0E44\u0E21\u0E48\u0E40\u0E2B\u0E47\u0E19\u0E23\u0E39\u0E49\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E40\u0E25\u0E22"
