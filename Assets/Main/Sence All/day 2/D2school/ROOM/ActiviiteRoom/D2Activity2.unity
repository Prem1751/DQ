    scoreBasedSceneName: 
  - text: "\u0E40\u0E2D\u0E32\u0E40\u0E16\u0E2D\u0E30 \u0E09\u0E31\u0E19\u0E44\u0E21\u0E48\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E08\u0E30\u0E1E\u0E39\u0E14\u0E01\u0E31\u0E1A\u0E19\u0E32\u0E22\u0E2B\u0E23\u0E2D\u0E01\u0E19\u0E30"
