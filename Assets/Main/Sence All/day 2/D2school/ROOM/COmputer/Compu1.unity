    scoreBasedSceneName: 
  - text: "\u0E40\u0E08\u0E2D\u0E23\u0E39\u0E1B\u0E04\u0E39\u0E48\u0E02\u0E2D\u0E07\u0E40\u0E0A\u0E19\u0E01\u0E31\u0E1A\u0E25\u0E34\u0E25\u0E25\u0E17\u0E35\u0E48\u0E16\u0E48\u0E32\u0E22\u0E14\u0E49\u0E27\u0E22\u0E01\u0E31\u0E19"
