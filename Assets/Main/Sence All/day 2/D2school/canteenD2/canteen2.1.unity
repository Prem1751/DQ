--- !u!114 &981473657
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 981473654}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49960fbb7a9824245b2a70542b30da56, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 1712080562}
  nameText: {fileID: 1241095298}
  dialogueText: {fileID: 60502909}
  speakerImage: {fileID: 1909596211}
  defaultNpcName: NPC
  dialogueLines:
  - text: "\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E0B\u0E34\u0E19\u0E01\u0E31\u0E1A\u0E14\u0E32\u0E23\u0E34\u0E19\u0E21\u0E32\u0E16\u0E36\u0E07\u0E42\u0E23\u0E07\u0E2D\u0E32\u0E2B\u0E32\u0E23
      \u0E01\u0E47\u0E21\u0E35\u0E41\u0E15\u0E48\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E0B\u0E38\u0E1A\u0E0B\u0E34\u0E1A\u0E14\u0E31\u0E07\u0E44\u0E1B\u0E2B\u0E21\u0E14\r\n\u0E41\u0E25\u0E49\u0E27\u0E08\u0E39\u0E48\u0E46
      \u0E01\u0E47\u0E21\u0E35\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E1B\u0E23\u0E30\u0E01\u0E32\u0E28\u0E14\u0E31\u0E07\u0E02\u0E36\u0E49\u0E19"
    characterName: ...
    characterSprite: {fileID: 158472470585449025, guid: d6de88a9f7957c440a5e40131d6186f8, type: 3}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
    choiceScores: 
    choiceLeadsTo: 
    postChoiceDialogue: 
    changeSceneAfterThisLine: 0
    sceneNameToLoad: 
    sceneTransitionDelay: 0
    useScoreBasedTransition: 0
    requiredScore: 0
    scoreBasedSceneName: 
  - text: "\u0E14\u0E32\u0E23\u0E34\u0E19 \u0E21\u0E32\u0E1E\u0E1A\u0E04\u0E38\u0E13\u0E04\u0E23\u0E39\u0E17\u0E35\u0E48\u0E2B\u0E49\u0E2D\u0E07\u0E1E\u0E31\u0E01\u0E04\u0E23\u0E39\u0E2B\u0E19\u0E48\u0E2D\u0E22"
    characterName: "\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E44\u0E21\u0E04\u0E4C\u0E1B\u0E23\u0E30\u0E0A\u0E32\u0E2A\u0E31\u0E21\u0E1E\u0E31\u0E19\u0E18\u0E4C"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
    choiceScores: 
    choiceLeadsTo: 
    postChoiceDialogue: 
    changeSceneAfterThisLine: 0
    sceneNameToLoad: 
    sceneTransitionDelay: 0
    useScoreBasedTransition: 0
    requiredScore: 0
    scoreBasedSceneName: 
  - text: "\u0E0B\u0E34\u0E19\u0E23\u0E39\u0E49\u0E2A\u0E36\u0E01\u0E41\u0E1B\u0E25\u0E01\u0E46
      \u0E08\u0E36\u0E07\u0E40\u0E1B\u0E34\u0E14\u0E41\u0E0A\u0E17\u0E01\u0E25\u0E38\u0E48\u0E21\u0E02\u0E36\u0E49\u0E19\u0E21\u0E32"
    characterName: ...
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
    choiceScores: 
    choiceLeadsTo: 
    postChoiceDialogue: 
    changeSceneAfterThisLine: 0
    sceneNameToLoad: 
    sceneTransitionDelay: 0
    useScoreBasedTransition: 0
    requiredScore: 0
    scoreBasedSceneName: 
  - text: "\u0E19\u0E31\u0E01\u0E40\u0E23\u0E35\u0E22\u0E191: \u0E40\u0E2B\u0E47\u0E19\u0E02\u0E48\u0E32\u0E27\u0E2B\u0E23\u0E37\u0E2D\u0E22\u0E31\u0E07
      \u0E17\u0E35\u0E48\u0E14\u0E32\u0E23\u0E34\u0E19\u0E42\u0E01\u0E07\u0E02\u0E49\u0E2D\u0E2A\u0E2D\u0E1A\r\n\u0E19\u0E31\u0E01\u0E40\u0E23\u0E35\u0E22\u0E192:
      \u0E40\u0E2D\u0E2D \u0E40\u0E2B\u0E47\u0E19\u0E25\u0E30 \u0E01\u0E47\u0E27\u0E48\u0E32\u0E2D\u0E22\u0E39\u0E48\u0E17\u0E33\u0E44\u0E21\u0E44\u0E14\u0E49\u0E04\u0E30\u0E41\u0E19\u0E19\u0E14\u0E35\u0E15\u0E25\u0E2D\u0E14\n"
    characterName: "\u0E41\u0E0A\u0E17"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices:
    - "\u0E2B\u0E49\u0E2D\u0E07\u0E01\u0E34\u0E08\u0E01\u0E23\u0E23\u0E21"
    - "\u0E2B\u0E49\u0E2D\u0E07\u0E14\u0E19\u0E15\u0E23\u0E35"
    choiceScores: 
    choiceLeadsTo: 
    postChoiceDialogue: 
    changeSceneAfterThisLine: 0
    sceneNameToLoad: 
    sceneTransitionDelay: 0
    useScoreBasedTransition: 0
    requiredScore: 0
    scoreBasedSceneName: 
  - text: "\u0E19\u0E31\u0E01\u0E40\u0E23\u0E35\u0E22\u0E193: \u0E14\u0E32\u0E23\u0E34\u0E19\u0E40\u0E19\u0E35\u0E48\u0E22\u0E19\u0E30!
      \u0E09\u0E31\u0E19\u0E27\u0E48\u0E32\u0E14\u0E32\u0E23\u0E34\u0E19\u0E01\u0E47\u0E43\u0E2A\u0E46
      \u0E19\u0E30\u0E41\u0E01 \u0E44\u0E21\u0E48\u0E19\u0E48\u0E32\u0E42\u0E01\u0E07\u0E02\u0E49\u0E2D\u0E2A\u0E2D\u0E1A\u0E2B\u0E19\u0E2D\u0E01"
    characterName: "\u0E41\u0E0A\u0E17"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
    hasChoices: 0
    choices: []
    choiceScores: 
    choiceLeadsTo: 
    postChoiceDialogue: 
    changeSceneAfterThisLine: 0
    sceneNameToLoad: 
    sceneTransitionDelay: 0
    useScoreBasedTransition: 0
    requiredScore: 0
    scoreBasedSceneName: 
  - text: "\u0E19\u0E31\u0E01\u0E40\u0E23\u0E35\u0E22\u0E191: \u0E04\u0E19\u0E40\u0E23\u0E32\u0E21\u0E31\u0E19\u0E23\u0E39\u0E49\u0E2B\u0E19\u0E49\u0E32\u0E44\u0E21\u0E48\u0E23\u0E39\u0E49\u0E43\u0E08\u0E2D\u0E22\u0E39\u0E48\u0E41\u0E25\u0E49\u0E27\r\n\u0E19\u0E31\u0E01\u0E40\u0E23\u0E35\u0E22\u0E194:
      \u0E40\u0E23\u0E32\u0E2D\u0E22\u0E48\u0E32\u0E40\u0E1E\u0E34\u0E48\u0E07\u0E23\u0E35\u0E1A\u0E15\u0E31\u0E14\u0E2A\u0E34\u0E19\u0E2D\u0E30\u0E44\u0E23\u0E01\u0E31\u0E19\u0E14\u0E35\u0E01\u0E27\u0E48\u0E32"
