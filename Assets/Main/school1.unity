  dialoguePanel: {fileID: 1665089232}
  nameText: {fileID: 123223150}
  dialogueText: {fileID: 1766025172}
  speakerImage: {fileID: 2069093568}
  defaultNpcName: Hyung-gil
  dialogueLines:
  - text: ...
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35"
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E44\u0E14\u0E49\u0E2D\u0E48\u0E32\u0E19\u0E21\u0E32\u0E1A\u0E49\u0E32\u0E07\u0E44\u0E2B\u0E21?"
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: " \u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E2D\u0E48\u0E32\u0E19 "
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E01\u0E47\u0E2A\u0E21\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E18\u0E2D\u0E14\u0E35 "
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35\u0E48"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E2D\u0E22\u0E48\u0E32\u0E1A\u0E31\u0E07\u0E17\u0E32\u0E07\u0E44\u0E14\u0E49\u0E44\u0E2B\u0E21"
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E2A\u0E21\u0E31\u0E22\u0E40\u0E14\u0E47\u0E01\u0E2A\u0E38\u0E14\u0E17\u0E35\u0E48\u0E23\u0E31\u0E01\u0E44\u0E1B\u0E44\u0E2B\u0E19\u0E41\u0E25\u0E49\u0E27"
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E14\u0E32\u0E23\u0E34\u0E19 \u0E04\u0E07\u0E08\u0E30\u0E2D\u0E48\u0E32\u0E19\u0E2B\u0E19\u0E31\u0E07\u0E2A\u0E37\u0E2D\u0E2D\u0E22\u0E39\u0E48"
    characterName: "\u0E0B\u0E35\u0E19"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
  - text: "\u0E01\u0E47\u0E40\u0E19\u0E2D\u0E30\u0E22\u0E31\u0E19\u0E19\u0E31\u0E49\u0E19\u0E21\u0E31\u0E19\u0E04\u0E19\u0E25\u0E30\u0E23\u0E30\u0E14\u0E31\u0E1A\u0E01\u0E31\u0E1A\u0E1E\u0E27\u0E01\u0E40\u0E23\u0E32\u0E19\u0E35\u0E48\u0E19\u0E32"
    characterName: "\u0E25\u0E34\u0E25\u0E25\u0E35"
    characterSprite: {fileID: 0}
    voiceOver: {fileID: 0}
